rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to validate IDs
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() < 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure leads collection
    match /leads/{leadId} {
      allow get: if false;
      allow list: if false;
      allow create: if isValidId(leadId) 
                    && request.resource.data.keys().hasAll(['lead_id', 'nome', 'telefone', 'status', 'created_at'])
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() > 0
                    && request.resource.data.nome.size() <= 200
                    && request.resource.data.telefone is string
                    && request.resource.data.telefone.size() > 0
                    && request.resource.data.telefone.size() <= 50;
      allow update, delete: if false;
    }

    // Secure analytics collection
    match /analytics/{docId} {
      allow read, write: if false;
    }
  }
}
